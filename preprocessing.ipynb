    "    _, current_bins, current_frames, channels = x.shape\n",
    "    features_per_frame = current_bins * channels\n",
    "    \n",
    "    # Permute to put Frames first: (Batch, Frames, Bins, Channels)\n",
    "    x = tf.keras.layers.Permute((2, 1, 3))(x)\n",
    "    # Reshape to: (Batch, Frames, Features)\n",
    "    x = tf.keras.layers.Reshape((current_frames, features_per_frame))(x)\n",
    "\n",
    "    # 3. Transformer Block\n",
    "    x = tf.keras.layers.MultiHeadAttention(num_heads=8, key_dim=64)(x, x)\n",
    "    x = tf.keras.layers.LayerNormalization()(x)\n",
    "\n",
    "    # 4. Upsample the Time Axis to reach your target length (1000 frames)\n",
    "    # Instead of manual multiplication, a Dense layer applied over a transposed matrix \n",
