    "import tensorflow as tf\n",
    "\n",
    "def build_model(n_bins=84, n_frames=313, n_keys=88, target_frames=1000):\n",
    "    inputs = tf.keras.Input(shape=(n_bins, n_frames, 1))\n",
    "\n",
    "    # 1. CNN Block — Notice we only max-pool the PITCH (n_bins) axis, NOT the time axis.\n",
    "    # This keeps our time tracking clean.\n",
    "    x = tf.keras.layers.Conv2D(64, (3,3), activation='relu', padding='same')(inputs)\n",
    "    x = tf.keras.layers.BatchNormalization()(x)\n",
    "    x = tf.keras.layers.MaxPooling2D((2,1))(x) # Pools frequency, leaves time alone\n",
    "    x = tf.keras.layers.Dropout(0.3)(x)\n",
    "\n",
    "    x = tf.keras.layers.Conv2D(128, (3,3), activation='relu', padding='same')(x)\n",
    "    x = tf.keras.layers.BatchNormalization()(x)\n",
    "    x = tf.keras.layers.MaxPooling2D((2,1))(x) # Pools frequency, leaves time alone\n",
    "    x = tf.keras.layers.Dropout(0.3)(x)\n",
    "\n",
    "    # 2. Reshape dynamically based on the tensor's actual calculated dimensions\n",
    "    # Current shape is (Batch, Remaining_Bins, Frames, Channels)\n",
